<Window x:Class="Prison.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prison Block 13" Height="580" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#E5E7E9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#D5D8DC"
                BorderBrush="#5D6D7E"
                BorderThickness="3"
                CornerRadius="2"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="Type:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontWeight="Bold"
                           FontFamily="Consolas"/>

                <ComboBox x:Name="TypeComboBox"
                          Width="130"
                          Margin="0,0,20,0"
                          Padding="4"
                          FontFamily="Consolas">

                    <ComboBoxItem Content="Rookie" IsSelected="True"/>
                    <ComboBoxItem Content="Philosopher"/>
                    <ComboBoxItem Content="Artist"/>
                    <ComboBoxItem Content="Cook"/>

                </ComboBox>

                <TextBlock Text="Name:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontWeight="Bold"
                           FontFamily="Consolas"/>

                <TextBox x:Name="NameTextBox"
                         Width="150"
                         Margin="0,0,20,0"
                         Padding="4"
                         FontFamily="Consolas"/>

                <!-- Стандартная кнопка -->
                <Button Content="Add Prisoner"
                        Click="AddButton_Click"
                        Padding="15,5"
                        Background="#2C3E50"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="1"
                        BorderBrush="Black"
                        Cursor="Hand"/>

            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#2C3E50" Padding="5">
                    <TextBlock Text="Prisoners List"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               FontFamily="Consolas"/>
                </Border>

                <ListBox x:Name="PrisonersList"
                         Grid.Row="1"
                         DisplayMemberPath="Name"
                         SelectionChanged="PrisonersList_SelectionChanged"
                         Background="#F2F3F4"
                         BorderBrush="#5D6D7E"
                         BorderThickness="3,0,3,3"
                         Padding="5"
                         FontFamily="Consolas"
                         FontSize="14"/>

                <Button Grid.Row="2"
                        Content="Remove Selected"
                        Click="RemoveButton_Click"
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="#A93226"
                        Foreground="White"
                        BorderThickness="2"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        FontFamily="Consolas"
                        Cursor="Hand"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Досье и энергия -->
                <Border Grid.Row="0"
                        Background="#F8F9F9"
                        BorderBrush="#5D6D7E"
                        BorderThickness="3"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <TextBlock Text="Selected Prisoner:"
                                   FontWeight="Bold"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,5"
                                   Foreground="#7F8C8D"/>

                        <TextBlock x:Name="SelectedInfoText"
                                   Text="Select a prisoner..."
                                   FontStyle="Italic"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Energy:"
                                   FontWeight="Bold"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,5"/>

                        <ProgressBar x:Name="EnergyBar"
                                     Height="22"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Energy, Mode=OneWay}"
                                     Foreground="#27AE60"
                                     Background="#D5D8DC"
                                     BorderBrush="#5D6D7E"
                                     BorderThickness="1"/>
                    </StackPanel>
                </Border>

                <WrapPanel Grid.Row="1"
                           Margin="0,0,0,15"
                           HorizontalAlignment="Center">

                    <Button Content="Normal Action"
                            Click="NormalAction_Click"
                            Width="110"
                            Margin="5"
                            Padding="8"
                            Background="#BDC3C7"
                            BorderBrush="#7F8C8D"
                            BorderThickness="2"
                            FontWeight="Bold"/>

                    <Button Content="Rest"
                            Click="RestAction_Click"
                            Width="110"
                            Margin="5"
                            Padding="8"
                            Background="#BDC3C7"
                            BorderBrush="#7F8C8D"
                            BorderThickness="2"
                            FontWeight="Bold"/>

                    <Button Content="Work"
                            Click="WorkAction_Click"
                            Width="110"
                            Margin="5"
                            Padding="8"
                            Background="#BDC3C7"
                            BorderBrush="#7F8C8D"
                            BorderThickness="2"
                            FontWeight="Bold"/>

                    <Button Content="Study"
                            Click="StudyAction_Click"
                            Width="110"
                            Margin="5"
                            Padding="8"
                            Background="#BDC3C7"
                            BorderBrush="#7F8C8D"
                            BorderThickness="2"
                            FontWeight="Bold"/>

                    <Button Content="Crazy Action"
                            Click="CrazyAction_Click"
                            Width="230"
                            Margin="5"
                            Padding="8"
                            Background="#E67E22"
                            Foreground="Black"
                            BorderBrush="Black"
                            BorderThickness="2"
                            FontWeight="Bold"/>
                </WrapPanel>

                <Border Grid.Row="2"
                        Background="#EAEDED"
                        BorderBrush="#5D6D7E"
                        BorderThickness="3"
                        Padding="5">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Event Log:"
                                   FontWeight="Bold"
                                   FontFamily="Consolas"
                                   Margin="5,0,0,5"/>

                        <ListBox x:Name="LogList"
                                 Grid.Row="1"
                                 Background="#FFFFFF"
                                 BorderThickness="1"
                                 BorderBrush="#BDC3C7"
                                 Padding="5"
                                 FontFamily="Consolas"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>