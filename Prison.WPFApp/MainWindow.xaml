<Window x:Class="Prison.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prison Block 13" Height="860" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#EAEAEA">

    <Window.Resources>
        <Style x:Key="BoxBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#2B3E50"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#F9F9F9"/>
        </Style>

        <Style x:Key="StandardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#BDC3C7"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#7F8C8D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="460"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource BoxBorderStyle}" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="13"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}" VerticalAlignment="Center" Margin="0,0,16,6" Height="26"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Name:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="13"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding NewInmateName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,16,6" Height="26"/>

                <Button Grid.Row="0" Grid.Column="4" Content="Add Prisoner" Command="{Binding AddCommand}" Style="{StaticResource StandardButtonStyle}" Width="150" Height="28" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Search:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,2,8,0" FontSize="13"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,2,16,0" Height="26"/>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock Text="Sort:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
                    <Button Content="Name" Command="{Binding SortByNameCommand}" Style="{StaticResource StandardButtonStyle}" Width="85" Height="26" Margin="0,0,8,0"/>
                    <Button Content="Energy" Command="{Binding SortByEnergyCommand}" Style="{StaticResource StandardButtonStyle}" Width="85" Height="26"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource BoxBorderStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#223547">
                        <Grid Margin="12,0">
                            <TextBlock Text="Prisoners List" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="💡" Foreground="#F1C40F" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding DisplayedInmates}" SelectedItem="{Binding SelectedPrisoner}" 
                             BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" Foreground="#7F8C8D"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Energy, StringFormat='{}{0}%'}" FontWeight="SemiBold" Foreground="#34495E" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Remove Selected" Command="{Binding RemoveCommand}"
                            Background="#AC3226" Foreground="White" FontWeight="Bold" FontSize="13" Height="38" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource BoxBorderStyle}" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Selected Prisoner:" Foreground="#7F8C8D" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedPrisonerText}" FontWeight="Bold" FontSize="16" Foreground="#2C3E50" Margin="0,2,0,4"/>

                        <TextBlock Text="Energy:" FontWeight="Bold" FontSize="12" Margin="0,0,0,2"/>
                        <ProgressBar Value="{Binding SelectedPrisoner.Energy, Mode=OneWay}" Maximum="100" Minimum="0" Height="22" 
                                     Foreground="#2C3E50" Background="#BDC3C7" BorderThickness="0" Margin="0,0,0,4"/>

                        <TextBlock Text="{Binding GroupSummaryText}" FontStyle="Italic" Foreground="#555" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="Normal Action" Command="{Binding NormalActionCommand}" Style="{StaticResource StandardButtonStyle}" Margin="0,0,4,4"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="Rest" Command="{Binding RestCommand}" Style="{StaticResource StandardButtonStyle}" Margin="2,0,2,4"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Work" Command="{Binding WorkCommand}" Style="{StaticResource StandardButtonStyle}" Margin="4,0,0,4"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="Study" Command="{Binding StudyCommand}" Style="{StaticResource StandardButtonStyle}" Margin="0,2,4,0"/>
                    <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="Crazy Action" Command="{Binding CrazyActionCommand}" 
                            Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="14" BorderBrush="#D35400" BorderThickness="1" Margin="2,2,0,0"/>
                </Grid>
                
                <Border Grid.Row="2" Style="{StaticResource BoxBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#D5DBDB" Padding="8,0">
                            <Grid>
                                <TextBlock Text="Event Log:" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                <TextBlock Text="💡" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" ItemsSource="{Binding EventLogs}" BorderThickness="0" Background="White" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource BoxBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок Vol.3 -->
                <Border Grid.Row="0" Background="#223547" Padding="10,0">
                    <TextBlock Text="Vol.3 — Async CPU Simulation &amp; Multithreading" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>

                <Grid Grid.Row="1" Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Workload:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Workload, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="25" Margin="0,0,12,0"/>

                    <CheckBox Grid.Column="2" Content="Simulate Error (on 2nd item)" IsChecked="{Binding SimulateErrorOnSecond}" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold"/>

                    <Button Grid.Column="3" Content="Run Sequential" Command="{Binding StartSequentialCommand}" Style="{StaticResource StandardButtonStyle}" Margin="0,0,6,0"/>
                    <Button Grid.Column="4" Content="Run Parallel" Command="{Binding StartParallelCommand}" Style="{StaticResource StandardButtonStyle}" Margin="0,0,8,0"/>
                    <Button Grid.Column="5" Content="Tühista (Cancel)" Command="{Binding CancelCommand}" Background="#E74C3C" Foreground="White" FontWeight="Bold" Padding="10,4" BorderThickness="0"/>

                    <TextBlock Grid.Column="6" Text="{Binding TotalExecutionTimeText}" FontWeight="Bold" Foreground="#2980B9" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13"/>
                </Grid>

                <DataGrid Grid.Row="2" ItemsSource="{Binding SimulationReports}" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="White" BorderThickness="0,1,0,0" BorderBrush="#BDC3C7" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Prisoner" Binding="{Binding PrisonerName}" Width="180"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="110"/>
                        <DataGridTextColumn Header="Result / Error message" Binding="{Binding ResultOrError}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>