<Window x:Class="Prison.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prison Block 13" Height="680" Width="820"
        Background="#D3D7DE" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#DFE3E8" BorderBrush="#2C3E50" BorderThickness="2" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Type:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,8,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}" Height="28" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="Name:" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,8,0"/>
                    <TextBox Grid.Column="3" Text="{Binding NewInmateName, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,15,0" VerticalContentAlignment="Center" Background="White"/>

                    <Button Grid.Column="4" Content="Add Prisoner" Command="{Binding AddCommand}" Height="30" Background="#243342" Foreground="White" FontWeight="Bold"/>
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Search:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="24" Margin="0,0,15,0" VerticalContentAlignment="Center" Background="White"/>

                    <TextBlock Text="Sort:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button Content="Name" Command="{Binding SortByNameCommand}" Width="75" Height="24" Margin="0,0,5,0" Background="#BDC3C7" BorderBrush="#2C3E50"/>
                    <Button Content="Energy" Command="{Binding SortByEnergyCommand}" Width="75" Height="24" Background="#BDC3C7" BorderBrush="#2C3E50"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#2C3E50" BorderThickness="2" Background="White" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#243342">
                        <Grid Margin="10,0">
                            <TextBlock Text="Prisoners List" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Text="💡" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding DisplayedInmates}" SelectedItem="{Binding SelectedPrisoner}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="100"/>
                                    <TextBlock Text="{Binding TypeName}" Foreground="#7F8C8D" Width="90"/>
                                    <TextBlock Text="{Binding Energy, StringFormat='{}{0}%'}" Foreground="#2C3E50" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Remove Selected" Command="{Binding RemoveCommand}" 
                            Background="#A83226" Foreground="White" FontWeight="Bold" Margin="4" BorderThickness="0"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#2C3E50" BorderThickness="2" Background="#F8F9FA" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Selected Prisoner:" Foreground="#7F8C8D" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedPrisonerText}" FontFamily="Courier New" FontSize="15" FontWeight="Bold" Margin="0,3,0,8"/>

                        <TextBlock Text="Energy:" FontWeight="Bold" Margin="0,0,0,3"/>
                        <ProgressBar Value="{Binding SelectedPrisoner.Energy, FallbackValue=0}" Maximum="100" Height="22" Background="#BDC3C7" Foreground="#34495E" BorderBrush="#7F8C8D"/>

                        <TextBlock Text="{Binding GroupSummaryText}" Margin="0,8,0,0" Foreground="#2C3E50" FontSize="11" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="Normal Action" Command="{Binding NormalActionCommand}" Margin="0,0,6,6" Background="#BDC3C7" BorderBrush="#2C3E50" FontWeight="SemiBold"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="Rest" Command="{Binding RestCommand}" Margin="0,0,6,6" Background="#BDC3C7" BorderBrush="#2C3E50" FontWeight="SemiBold"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Work" Command="{Binding WorkCommand}" Margin="0,0,0,6" Background="#BDC3C7" BorderBrush="#2C3E50" FontWeight="SemiBold"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="Study" Command="{Binding StudyCommand}" Margin="0,0,6,0" Background="#BDC3C7" BorderBrush="#2C3E50" FontWeight="SemiBold"/>
                    <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="Crazy Action" Command="{Binding CrazyActionCommand}" Background="#E67E22" BorderBrush="#2C3E50" FontWeight="Bold" FontSize="13"/>
                </Grid>

                <Border Grid.Row="2" BorderBrush="#2C3E50" BorderThickness="2" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#DFE3E8" BorderBrush="#2C3E50" BorderThickness="0,0,0,1">
                            <Grid Margin="8,0">
                                <TextBlock Text="Event Log:" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="💡" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="EventListBox" Grid.Row="1" ItemsSource="{Binding EventLogs}" BorderThickness="0" FontFamily="Consolas" FontSize="11" Margin="4"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>